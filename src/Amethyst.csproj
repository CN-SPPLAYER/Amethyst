<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Amethyst</AssemblyName>
    <RootNamespace>Amethyst</RootNamespace>
    <TargetFramework>netcoreapp6.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Version>1.1.8</Version>
    <Company>一只屑小紫</Company>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- ===== 游戏参考程序集目录（第 187 轮更换）=====
       ⚠ 不要再用 `Новая папка (2)\lib\`：那是**旧版**游戏（v18.x）的程序集，
         它的 `RoleTypes` 枚举只有 14 个值，缺 `SpiritGuide`(=网红/Influencer)。
         游戏已于 2026-09-29 更新到 **v19.0**，新增了该职业。
         现在统一指向 `_refs\`，它是「BepInEx\interop\（当前游戏真实 API，121 个）」
         + 「BepInEx\core\（interop 里缺的那几个：0Harmony / Il2CppInterop.Runtime /
            BepInEx.Core / BepInEx.Unity.IL2CPP）」合并出来的，共 128 个。
         见 docs\ANTICHEAT_FIX_NOTES.md 第 187 轮的刷新脚本。 -->
  <PropertyGroup>
    <GameRefsDir Condition="'$(GameRefsDir)'=='' and Exists('$(MSBuildThisFileDirectory)..\_refs\')">$(MSBuildThisFileDirectory)..\_refs\</GameRefsDir>
    <GameRefsDir Condition="'$(GameRefsDir)'=='' and Exists('$(MSBuildThisFileDirectory)..\Новая папка (2)\lib\')">$(MSBuildThisFileDirectory)..\Новая папка (2)\lib\</GameRefsDir>
  </PropertyGroup>

