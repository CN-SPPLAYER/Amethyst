    <EmbeddedResource Include="Resources\KeyGuide\KeyBindCharacters2.png" LogicalName="Amethyst.Resources.KeyGuide.KeyBindCharacters2.png" />
    <EmbeddedResource Include="Resources\KeyGuide\KeyBindCharacters3.png" LogicalName="Amethyst.Resources.KeyGuide.KeyBindCharacters3.png" />
    <EmbeddedResource Include="Resources\KeyGuide\KeyBindCharacters4.png" LogicalName="Amethyst.Resources.KeyGuide.KeyBindCharacters4.png" />
    <EmbeddedResource Include="Resources\KeyGuide\KeyBindCharacters5.png" LogicalName="Amethyst.Resources.KeyGuide.KeyBindCharacters5.png" />
