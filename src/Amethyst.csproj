  <!-- ===== 版本化产物命名（第 277 轮）=====
       统一命名：Amethyst_<版本>_Windows.dll / Amethyst_<版本>_Android.dll。
       输出目录：
         · dist\                 交付 / 上传用
         · _backup_20260927\     历史归档
       注意：插件目录里仍部署为 Amethyst.dll，避免升级后同 GUID 的旧版本并存。 -->
  <Target Name="CopyVersionedDll" AfterTargets="Build" Condition="'$(Configuration)'=='Release'">
    <MakeDir Directories="$(MSBuildThisFileDirectory)..\dist;$(MSBuildThisFileDirectory)..\_backup_20260927" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFiles="$(OutputPath)$(AssemblyName)_$(Version)_Windows.dll"
          ContinueOnError="true" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFiles="$(MSBuildThisFileDirectory)..\dist\$(AssemblyName)_$(Version)_Windows.dll"
          ContinueOnError="true" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFiles="$(MSBuildThisFileDirectory)..\_backup_20260927\$(AssemblyName)_$(Version)_Windows.dll"
          ContinueOnError="true" />
  </Target>

  <Target Name="GenerateVersionFile" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <VersionFile>$(IntermediateOutputPath)GeneratedVersion.cs</VersionFile>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;&amp; '$(MSBuildThisFileDirectory)GenerateVersion.ps1' -Version '$(Version)' -OutFile '$(VersionFile)'&quot;" />
    <ItemGroup>
      <Compile Include="$(VersionFile)" />
    </ItemGroup>
  </Target>

  <!-- ===== 编译后自动部署到游戏目录（第 172 轮新增）=====
       用途：`dotnet build -c Release` 之后自动把产物送进游戏的 BepInEx\plugins\，
             省掉手工复制。

       ⚠ 只部署到 **BepInEx\plugins\**（BepInEx 真正加载的位置）。
         游戏目录下/`BepInEx\` 根目录里那些同名 Amethyst*.dll 是**历史遗留副本，不会被加载**，
         往那儿写只会造成"到底哪个在生效"的混淆，所以本 Target 不碰它们。

       ⚠ 不覆盖 config：BepInEx\config\amethyst.mod.cfg 保存着用户设置，绝不触碰
         （新版本号会让 BepInEx 自己补新条目，删掉反而丢设置）。

       路径优先级：命令行 -p:DeployDir=... > 环境变量 AMETHYST_DEPLOY_DIR > 下面的默认值。
       找不到目录时只告警、**不让编译失败**（换机器/没装游戏也能正常 build）。
       游戏正在运行时 DLL 会被占用，这里只告警并提示关掉游戏，不改用其它手段强写。 -->
  <PropertyGroup>
    <DeployDir Condition="'$(DeployDir)'=='' and '$(AMETHYST_DEPLOY_DIR)'!=''">$(AMETHYST_DEPLOY_DIR)</DeployDir>
    <DeployDir Condition="'$(DeployDir)'==''">E:\steam\steamapps\common\Among Us\BepInEx\plugins\</DeployDir>
  </PropertyGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Configuration)'=='Release'">
    <PropertyGroup>
      <_DeployDll>$(DeployDir)$(AssemblyName).dll</_DeployDll>
    </PropertyGroup>

    <Warning Condition="!Exists('$(DeployDir)')"
             Text="部署跳过：找不到目录 '$(DeployDir)'。可用 -p:DeployDir=&quot;...\BepInEx\plugins\&quot; 指定。" />

    <Exec Condition="Exists('$(DeployDir)')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;&amp; '$(MSBuildThisFileDirectory)Deploy.ps1' -Source '$(OutputPath)$(AssemblyName).dll' -TargetDir '$(DeployDir)' -Version '$(Version)'&quot;" />
  </Target>

</Project>
