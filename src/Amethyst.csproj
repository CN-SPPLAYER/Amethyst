  <!-- ===== 音乐播放器解码依赖（NAudio / NVorbis）=====
       ⚠ 为什么放弃 UnityWebRequestMultimedia.GetAudioClip：
         游戏 IL2CPP 把 `DownloadHandlerAudioClip..ctor(String, AudioType)` 裁掉了，
         运行时抛 MissingMethodException，永远拿不到 AudioClip
         （表现为"加载很久" + 没声音）。所以改走手动解码 PCM。

       为什么是「嵌入 + 运行时释放 + AssemblyResolve」而不是普通 PackageReference：
         BepInEx/IL2CPP 不会自动解析模组旁的 NuGet 依赖，
         直接 PackageReference 只在编译期可用，运行时抛 FileNotFoundException。

       NAudio / NVorbis 均为 MIT 许可的第三方开源库（非本模组资产）：
         · NAudio  — https://github.com/naudio/NAudio   (MIT, © Mark Heath)
         · NVorbis — https://github.com/NVorbis/NVorbis (MIT, © Andrew Ward)
       MIT 要求随分发保留版权与许可声明，因此 csproj 把两者的许可证全文
       （Resources\Licenses\*.txt）也嵌入，运行时与 DLL 一起释放到 Amethyst\libs。 -->
  <PropertyGroup>
    <_NuGetBase>$(USERPROFILE)\.nuget\packages\</_NuGetBase>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(_NuGetBase)naudio\2.2.1\lib\net6.0\NAudio.dll">
      <LogicalName>Amethyst.libs.NAudio.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(_NuGetBase)naudio.core\2.2.1\lib\netstandard2.0\NAudio.Core.dll">
      <LogicalName>Amethyst.libs.NAudio.Core.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(_NuGetBase)naudio.winmm\2.2.1\lib\netstandard2.0\NAudio.WinMM.dll">
      <LogicalName>Amethyst.libs.NAudio.WinMM.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(_NuGetBase)nvorbis\0.10.5\lib\netstandard2.0\NVorbis.dll">
      <LogicalName>Amethyst.libs.NVorbis.dll</LogicalName>
    </EmbeddedResource>

    <!-- MIT 要求随分发保留版权与许可声明：许可证全文与依赖一起释放到 Amethyst\libs -->
    <EmbeddedResource Include="Resources\Licenses\THIRD-PARTY-NOTICES.txt">
      <LogicalName>Amethyst.libs.THIRD-PARTY-NOTICES.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Licenses\NAudio-LICENSE.txt">
      <LogicalName>Amethyst.libs.NAudio-LICENSE.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Licenses\NVorbis-LICENSE.txt">
      <LogicalName>Amethyst.libs.NVorbis-LICENSE.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
